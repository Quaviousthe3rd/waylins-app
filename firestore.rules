rules_version = '2';

// INTERIM RULES — documented trust boundary, not the final state.
//
// Public read on bookings and public create on bookings are left open ONLY
// as a documented interim until the Cloud Functions phase, when booking
// creation and payment verification move server-side (Paystack webhook +
// callable functions). At that point:
//   - bookings read will be restricted (clients query via a function),
//   - bookings create will be denied to clients entirely.
// Do not treat the open bookings rules below as acceptable long-term.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'qaabilmullah@gmail.com';
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

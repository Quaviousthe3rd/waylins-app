rules_version = '2';

// INTERIM RULES — documented trust boundary, not the final state.
//
// Booking creation is now server-only (Paystack webhook, Admin SDK).
// Public READ on bookings remains open ONLY as a documented interim: the
// client portal's payment-confirmation listener and MyBookings both query
// the collection directly. Next step: move client reads behind a callable
// function and restrict read here.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'qaabilmullah@gmail.com';
    }

    // paymentConfig (Paystack subaccount routing) is server-only: no client
    // read or write. Cloud Functions use the Admin SDK, which bypasses rules;
    // the owner edits it via the Firebase console.
    match /settings/{doc} {
      allow read: if doc != 'paymentConfig';
      allow write: if isAdmin() && doc != 'paymentConfig';
    }

    // pendingPayments (payment intents) are written by initTransaction only.
    match /pendingPayments/{reference} {
      allow read, write: if false;
    }

    // ledger: the money audit trail, written ONLY by the paystackWebhook
    // function (Admin SDK). Admin may read; nobody writes through rules.
    match /ledger/{reference} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bookings are created ONLY server-side (paystackWebhook via Admin SDK,
    // which bypasses rules) — clients can no longer write bookings.
    // Public read stays open as a documented interim: the client portal's
    // post-payment confirmation listener queries bookings by
    // paymentReference, and MyBookings reads by phone.
    match /bookings/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // events: booking lifecycle audit trail, written ONLY by the
    // onBookingWritten trigger (Admin SDK). Admin may read; no client writes.
    match /events/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // alertThrottle: server-side alert rate-limit bookkeeping. Server only.
    match /alertThrottle/{key} {
      allow read, write: if false;
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
